#!/bin/sh
# /usr/local/bin/vaultsync
#
# Two-way sync between the index-note spool (a shared NFS volume that the Pebble
# Index ring writes into) and a folder inside the Obsidian vault.
#
# Why sync at all, rather than mounting the spool into the vault directly: the
# vault is an emptyDir local to this pod, and `ob`'s change detection is inotify
# with no periodic rescan. Writes from another pod onto an NFS mount never fire
# inotify here, so notes mounted in from outside would sit in the vault forever
# and never upload. Copying them in from INSIDE this pod is what makes ob notice.
#
# THE FAILURE THIS GUARDS AGAINST. The vault is disposable: on every pod restart
# it is empty until `ob` re-pulls ~1,600 notes from Obsidian Sync. A two-way sync
# that ran during that window would read the empty vault as "everything was
# deleted" and propagate that into the spool, destroying captures that exist
# nowhere else. Both gates below exist for that one scenario.
set -eu

# 0002, not the default 0022. This container runs as the ingest service's uid so
# it can write the spool, but the `sync` container beside it runs as a different
# uid and must be able to OVERWRITE what this one creates in the vault: ob
# downloads and rewrites a note whenever the remote copy changes, which is
# exactly what happens when the owner ticks "Verified me" in Obsidian. Both
# containers share gid 1000 and the vault directory is setgid, so group-writable
# files are what let them coexist. With 0022 the sync container gets EACCES and
# stops syncing entirely, silently, until someone reads its log.
umask 0002

SPOOL=${SPOOL:-/inbox}
VAULT=${VAULT:-/data/vault}
SUBDIR=${SUBDIR:-Index Inbox}
ARCHIVE=${UNISON:-/data/state/unison}
MIN_VAULT_NOTES=${MIN_VAULT_NOTES:-500}
MAX_SYNC_AGE=${MAX_SYNC_AGE:-900}
INTERVAL=${INTERVAL:-300}
POKE_FILE=${POKE_FILE:-/data/state/sync-poke}
POKE_CHECK=${POKE_CHECK:-2}

export UNISON="$ARCHIVE"
mkdir -p "$ARCHIVE" "$VAULT/$SUBDIR"

while :; do
  # Gate 1: ob must be currently synced. If the websocket has wedged, the vault
  # is stale and we must not reason about what it does or does not contain.
  if ! syncprobe "$MAX_SYNC_AGE" >/dev/null 2>&1; then
    echo "{\"evt\":\"skip\",\"why\":\"sync not current\"}"
    sleep "$POKE_CHECK"; continue
  fi

  # Gate 2: the vault must look populated. This is the direct check for the
  # restart window, and it is deliberately crude: a count, not a heuristic.
  n=$(find "$VAULT" -name '*.md' -not -path "*/$SUBDIR/*" 2>/dev/null | wc -l)
  if [ "$n" -lt "$MIN_VAULT_NOTES" ]; then
    echo "{\"evt\":\"skip\",\"why\":\"vault has $n notes, below $MIN_VAULT_NOTES\"}"
    sleep "$POKE_CHECK"; continue
  fi

  # -ignore entries: Synology (@eaDir, thumbnails) and macOS (.DS_Store) litter
  # the share because it is also browsed over SMB. None of it belongs in a vault.
  # NO -prefer. Two different writers own different keys in the same file: the
  # voice scorer owns voice/voiceScore/voiceModel in the spool, and the owner
  # owns "Verified me" by ticking it in Obsidian, which arrives via the vault.
  # A whole-file "newer wins" resolves that by discarding one of them, and a
  # lost tick means a note silently misses the scorer's reference gallery with
  # no signal anywhere. VOICE.md 10 already forbids the scorer overwriting that
  # key; this is the same rule applied to the sync.
  #
  # -copyonconflict keeps both sides instead, so a conflict costs a stray file
  # to reconcile by hand and never costs data.
  #
  # -perms 0 -dontchmod: do not sync permission bits at all. The spool is NFS
  # with its own idea of modes and the vault is an emptyDir, so the two never
  # agree on the directory and unison reported "properties changed on both
  # sides" on EVERY pass. A conflict alarm that always fires is the same as no
  # alarm, and it would bury a real note conflict. Content is what matters here;
  # Obsidian does not care about the mode bits.
  unison "$SPOOL" "$VAULT/$SUBDIR" \
    -batch -auto -times -copyonconflict \
    -perms 0 -dontchmod \
    -ignore 'Name .DS_Store' \
    -ignore 'Name @eaDir' \
    -ignore 'Name .Trash*' \
    -ignore 'Name *.tmp' \
    -ignore 'Path .unison*' \
    -log=false 2>&1 | grep -vE '^(Contacting server|Looking for changes|Reconciling|Nothing to do)' \
    | tee /tmp/unison.out || true

  # Force group-writable after every pass. -perms 0 stops unison syncing mode
  # bits, but it also makes it CREATE files 0600 rather than honouring the
  # umask, which locks out the sync container running as a different uid. That
  # is a hard failure traded for a cosmetic warning, so do not rely on unison's
  # mode handling at all: assert the modes we need, every time. The tree is
  # small and this is idempotent.
  find "$VAULT/$SUBDIR" ! -perm -g+w -exec chmod g+rw {} + 2>/dev/null || true
  find "$VAULT/$SUBDIR" -type d ! -perm -g+s -exec chmod g+s {} + 2>/dev/null || true

  # A skipped item is a conflict unison refused to guess at. Silence here is the
  # failure mode this whole estate exists to avoid, so say it loudly.
  if grep -qiE 'conflict|skipped [1-9]|failed [1-9]' /tmp/unison.out 2>/dev/null; then
    echo "{\"evt\":\"conflict\",\"detail\":\"$(grep -iE 'conflict|skipped|failed' /tmp/unison.out | head -3 | tr '\n' ';' | tr -d '\"')\"}"
  fi

  # Sleep in short slices so a poke is picked up within POKE_CHECK seconds
  # rather than at the end of the interval. The poll is now a backstop for
  # pokes that were dropped, not the primary path, hence the long interval.
  waited=0
  while [ "$waited" -lt "$INTERVAL" ]; do
    if [ -f "$POKE_FILE" ]; then
      # Consume before syncing, never after. A poke arriving mid-run then
      # survives to trigger the next pass, instead of being swallowed by the
      # run that started too early to see its note.
      rm -f "$POKE_FILE"
      echo "{\"evt\":\"poked\"}"
      break
    fi
    sleep "$POKE_CHECK"
    waited=$((waited + POKE_CHECK))
  done
done
